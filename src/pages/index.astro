  <script>
    /* Landing interactions. Runs once as a module; re-initializes on every
       astro:page-load and tears down on astro:before-swap so navigation
       never duplicates loops or listeners. */

    let teardown: (() => void) | null = null;

    function init() {
      const root = document.getElementById("landing-root");
      if (!root) return;
      const cleanups: Array<() => void> = [];
      const on = (el: EventTarget, ev: string, fn: EventListenerOrEventListenerObject, opts?: AddEventListenerOptions) => {
        el.addEventListener(ev, fn, opts);
        cleanups.push(() => el.removeEventListener(ev, fn, opts));
      };

      /* ---- scroll reveal ----
         Native scroll-driven animation where supported; IntersectionObserver
         fallback elsewhere; nothing under prefers-reduced-motion. */
      const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const sdaReveal =
        !reduceMotion &&
        CSS.supports("(animation-timeline: view()) and (animation-range: entry)");
      if (sdaReveal) {
        document.documentElement.classList.add("sda-reveal");
        cleanups.push(() => document.documentElement.classList.remove("sda-reveal"));
      } else if (!reduceMotion) {
        document.documentElement.classList.add("js-reveal");
        cleanups.push(() => document.documentElement.classList.remove("js-reveal"));
        const revealIO = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("revealed");
              revealIO.unobserve(e.target);
            }
          }),
          { threshold: 0.08 },
        );
        root.querySelectorAll(".reveal").forEach((el) => revealIO.observe(el));
        cleanups.push(() => revealIO.disconnect());
      }

      /* ---- tabs (quickstart + SDK) ----
         ARIA tabs with roving tabindex, selection follows focus, and
         hidden="until-found" panels that stay find-in-page searchable. */
      const selectTab = (group: HTMLElement, btn: HTMLElement, focus = false) => {
        const name = btn.dataset.tab;
        group.querySelectorAll<HTMLElement>("[data-tab]").forEach((b) => {
          const active = b === btn;
          b.setAttribute("aria-selected", String(active));
          b.tabIndex = active ? 0 : -1;
        });
        group.querySelectorAll<HTMLElement>("[data-panel]").forEach((p) => {
          if (p.dataset.panel === name) p.removeAttribute("hidden");
          else p.setAttribute("hidden", "until-found");
        });
        if (focus) btn.focus();
      };
      on(root, "click", (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLElement>("[data-tab]");
        const group = btn?.closest<HTMLElement>("[data-tabs]");
        if (btn && group) selectTab(group, btn);
      });
      on(root, "keydown", (ev) => {
        const e = ev as KeyboardEvent;
        const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-tab]");
        const group = btn?.closest<HTMLElement>("[data-tabs]");
        if (!btn || !group) return;
        const tabs = Array.from(group.querySelectorAll<HTMLElement>("[data-tab]"));
        const i = tabs.indexOf(btn);
        let next: HTMLElement | undefined;
        if (e.key === "ArrowRight") next = tabs[(i + 1) % tabs.length];
        else if (e.key === "ArrowLeft") next = tabs[(i - 1 + tabs.length) % tabs.length];
        else if (e.key === "Home") next = tabs[0];
        else if (e.key === "End") next = tabs[tabs.length - 1];
        if (next) {
          e.preventDefault();
          selectTab(group, next, true);
        }
      });
      // Find-in-page revealed a hidden panel: sync the tab selection to it.
      on(root, "beforematch", (ev) => {
        const panel = (ev.target as HTMLElement).closest<HTMLElement>("[data-panel]");
        const group = panel?.closest<HTMLElement>("[data-tabs]");
        if (!panel || !group) return;
        const btn = group.querySelector<HTMLElement>(`[data-tab="${panel.dataset.panel}"]`);
        if (btn) selectTab(group, btn);
      });

      /* ---- copy code ----
         Declarative Invoker Commands (command="--copy" commandfor=…) with a
         click fallback where CommandEvent is missing. The role="status" span
         next to each button announces the outcome to screen readers. */
      const copyTimers = new WeakMap<HTMLElement, number>();
      const report = (btn: HTMLElement, ok: boolean) => {
        const status = btn.nextElementSibling;
        clearTimeout(copyTimers.get(btn));
        btn.textContent = ok ? "✓ 已复制" : "复制失败";
        btn.classList.toggle("text-green-400", ok);
        btn.classList.toggle("text-red-400", !ok);
        if (status) status.textContent = ok ? "已复制" : "复制失败";
        copyTimers.set(btn, window.setTimeout(() => {
          btn.textContent = "复制";
          btn.classList.remove("text-green-400", "text-red-400");
          if (status) status.textContent = "";
        }, 1600));
      };
      const copyCode = async (btn: HTMLElement, target: HTMLElement) => {
        const text = target.innerText;
        if (!text) return;
        let ok = true;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          try {
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            ok = document.execCommand("copy");
            ta.remove();
          } catch {
            ok = false;
          }
        }
        report(btn, ok);
      };
      // `command` events don't bubble: listen in the capture phase.
      on(document, "command", (ev) => {
        const e = ev as Event & { command?: string; source?: HTMLElement };
        if (e.command !== "--copy") return;
        const btn = e.source;
        const target = ev.target as HTMLElement;
        if (btn && target) void copyCode(btn, target);
      }, { capture: true });
      if (!("CommandEvent" in window)) {
        on(root, "click", (ev) => {
          const btn = (ev.target as HTMLElement).closest<HTMLElement>('button[command="--copy"]');
          if (!btn) return;
          const target = document.getElementById(btn.getAttribute("commandfor") ?? "");
          if (target) void copyCode(btn, target);
        });
      }

      /* ---- mobile menu ---- */
      const menuBtn = document.getElementById("menu-btn");
      const menu = document.getElementById("mobile-menu");
      if (menuBtn && menu) {
        on(menuBtn, "click", () => {
          const open = menu.classList.toggle("hidden") === false;
          menuBtn.setAttribute("aria-expanded", String(open));
        });
        menu.querySelectorAll("a").forEach((a) =>
          on(a, "click", () => {
            menu.classList.add("hidden");
            menuBtn.setAttribute("aria-expanded", "false");
          }),
        );
      }

      /* ---- scrollspy ----
         CSS scroll-target-group + :target-current does the tracking natively;
         script only mirrors the state into aria-current. IntersectionObserver
         fallback for browsers without it. */
      const spyLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-spy]"));
      if (CSS.supports("scroll-target-group: auto")) {
        const syncAriaCurrent = () => {
          const current = root.querySelector(".landing-nav a:target-current");
          spyLinks.forEach((l) => l.setAttribute("aria-current", l === current ? "true" : "false"));
        };
        // The current marker can settle a frame or two after scrollend,
        // so sync once more shortly after it.
        const scheduleSync = () => {
          syncAriaCurrent();
          window.setTimeout(syncAriaCurrent, 120);
        };
        scheduleSync();
        on(document, "scrollend", scheduleSync);
      } else {
        const spyIO = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (!e.isIntersecting) return;
            spyLinks.forEach((l) => {
              const active = l.dataset.spy === e.target.id;
              l.classList.toggle("nav-active", active);
              l.setAttribute("aria-current", String(active));
            });
          }),
          { rootMargin: "-30% 0px -60% 0px" },
        );
        spyLinks.forEach((l) => {
          const sec = document.getElementById(l.dataset.spy!);
          if (sec) spyIO.observe(sec);
        });
        cleanups.push(() => spyIO.disconnect());
      }

      /* ---- motion pause controls (WCAG 2.2.2) ---- */
      const marqueeBtn = document.getElementById("marquee-toggle");
      if (marqueeBtn) {
        on(marqueeBtn, "click", () => {
          const paused = marqueeBtn.closest("section")?.classList.toggle("marquee-paused") ?? false;
          marqueeBtn.textContent = paused ? "播放滚动" : "暂停滚动";
        });
      }
      const heroMotionBtn = document.getElementById("hero-motion-toggle");
      const heroEl = document.getElementById("top");
      let setEmbersPaused: (paused: boolean) => void = () => {};
      if (heroMotionBtn && heroEl) {
        if (reduceMotion) {
          heroMotionBtn.hidden = true;
        } else {
          on(heroMotionBtn, "click", () => {
            const paused = heroEl.classList.toggle("motion-paused");
            heroMotionBtn.textContent = paused ? "播放动画" : "暂停动画";
            setEmbersPaused(paused);
          });
        }
      }

      /* ---- count-up stats ---- */
      const counted = new WeakSet<Element>();
      const countIO = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (!e.isIntersecting || counted.has(e.target)) return;
          counted.add(e.target);
          const el = e.target as HTMLElement;
          const target = parseFloat(el.dataset.count ?? "0");
          const decimals = parseInt(el.dataset.decimals ?? "0", 10);
          const suffix = el.dataset.suffix ?? "";
          if (reduceMotion) {
            el.textContent = target.toFixed(decimals) + suffix;
            countIO.unobserve(el);
            return;
          }
          const t0 = performance.now();
          const dur = 1200;
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = (target * eased).toFixed(decimals) + suffix;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
          countIO.unobserve(el);
        }),
        { threshold: 0.5 },
      );
      root.querySelectorAll("[data-count]").forEach((el) => countIO.observe(el));
      cleanups.push(() => countIO.disconnect());

      /* ---- hero embers ---- */
      const canvas = document.getElementById("embers") as HTMLCanvasElement | null;
      const hero = document.getElementById("top");
      if (canvas && hero && !reduceMotion) {
        const ctx = canvas.getContext("2d");
        if (ctx) {
          let raf = 0;
          let running = false;
          let w = 0;
          let h = 0;
          const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          type P = { x: number; y: number; r: number; vy: number; vx: number; a: number; hue: number };
          let parts: P[] = [];
          const spawn = (): P => ({
            x: Math.random() * w,
            y: h + 10,
            r: 1 + Math.random() * 2.4,
            vy: 0.4 + Math.random() * 1.1,
            vx: (Math.random() - 0.5) * 0.35,
            a: 0.15 + Math.random() * 0.5,
            hue: 18 + Math.random() * 30,
          });
          const resize = () => {
            w = hero.clientWidth;
            h = hero.clientHeight;
            canvas.width = Math.round(w * dpr);
            canvas.height = Math.round(h * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            const n = Math.min(48, Math.round(w / 26));
            parts = Array.from({ length: n }, () => {
              const p = spawn();
              p.y = Math.random() * h;
              return p;
            });
          };
          const frame = () => {
            if (!running) return;
            ctx.clearRect(0, 0, w, h);
            for (const p of parts) {
              p.y -= p.vy;
              p.x += p.vx + Math.sin(p.y * 0.02) * 0.2;
              if (p.y < -12) Object.assign(p, spawn());
              const fade = Math.min(1, p.y / (h * 0.25));
              ctx.beginPath();
              ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
              ctx.fillStyle = `hsla(${p.hue}, 95%, 60%, ${p.a * fade})`;
              ctx.shadowColor = "rgba(249,115,22,0.8)";
              ctx.shadowBlur = 6;
              ctx.fill();
              ctx.shadowBlur = 0;
            }
            raf = requestAnimationFrame(frame);
          };
          const start = () => {
            if (running || document.hidden || hero.classList.contains("motion-paused")) return;
            running = true;
            raf = requestAnimationFrame(frame);
          };
          const stop = () => {
            running = false;
            cancelAnimationFrame(raf);
          };
          setEmbersPaused = (paused) => (paused ? stop() : start());
          resize();
          on(window, "resize", resize);
          const heroIO = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.02 });
          heroIO.observe(hero);
          on(document, "visibilitychange", () => (document.hidden ? stop() : start()));
          cleanups.push(() => {
            stop();
            heroIO.disconnect();
          });
        }
      }

      teardown = () => cleanups.forEach((fn) => fn());
    }

    document.addEventListener("astro:page-load", init);
    document.addEventListener("astro:before-swap", () => {
      teardown?.();
      teardown = null;
    });
  </script>
</BaseLayout>