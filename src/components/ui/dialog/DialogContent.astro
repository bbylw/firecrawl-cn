---
/**
 * DialogContent — inner frame of a Dialog. The dialog element itself is the
 * positioned, scrolling surface; this wrapper lays out the content column.
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

// A composing component can pass its own `data-slot` in place of this one.
const { class: className, "data-slot": slot = "dialog-content", ...attrs } = Astro.props;
---

<div data-slot={slot} class={cn("flex flex-col", className)} {...attrs}>
  <slot />
</div>
