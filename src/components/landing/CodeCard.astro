---
/**
 * Landing-page code card: glass terminal chrome + highlighted code.
 * The copy button is wired by the landing page's delegated click handler.
 */
import { highlight } from "@/lib/highlight";

interface Props {
  label: string;
  code: string;
  lang?: string;
  copy?: boolean;
  live?: boolean;
  dots?: boolean;
  small?: boolean;
  cursor?: boolean;
  class?: string;
}
const {
  label,
  code,
  lang = "text",
  copy = false,
  live = false,
  dots = false,
  small = false,
  cursor = false,
  class: cls = "",
} = Astro.props;

// Unique target id for the declarative copy command.
const codeId = `code-${Math.random().toString(36).slice(2, 10)}`;
---
<div class:list={["glass rounded-2xl overflow-hidden code-card", cls]}>
  <div class="flex items-center justify-between px-4 py-2.5 border-b border-ink-800">
    <div class="flex items-center gap-2 min-w-0">
      {dots && (
        <span class="flex gap-1.5 shrink-0">
          <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
        </span>
      )}
      <span class="text-xs text-ink-500 font-mono truncate">{label}</span>
      {live && (
        <span class="text-xs text-fire-400 flex items-center gap-1 shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-fire-500 animate-pulse"></span>
          实时
        </span>
      )}
    </div>
    {copy && (
      <button
        type="button"
        data-copy
        aria-label={`复制 ${label} 代码`}
        {...{ command: "--copy", commandfor: codeId }}
        class="inline-flex items-center justify-center min-w-6 min-h-6 text-xs text-ink-400 hover:text-fire-400 transition shrink-0 ml-3"
      >复制</button>
    )}
    {copy && <span class="copy-status" role="status"></span>}
  </div>
  <pre class:list={["code-block text-ink-200 overflow-x-auto", small ? "p-3" : "p-5"]}
    style={small ? "font-size:0.75rem" : undefined}><code id={codeId} set:html={highlight(code, lang)} />{cursor && <span class="term-cursor" aria-hidden="true"></span>}</pre>
</div>